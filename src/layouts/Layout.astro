---
import Reveal from "@components/Reveal.astro";
import "../styles/globals.css";
import Head from "@components/Head.astro";

export type Namespace = "Home" | "Catalog";

interface Props {
    namespace: Namespace;
}

const { namespace } = Astro.props;
---

<!doctype html>
<html lang="en">
    <Head
        title="Timbre: ba dum tss"
        description="The sound library that makes your web projects stand out."
    />
    <body data-barba="wrapper" class="flex min-h-dvh flex-col font-sans">
        <Reveal />
        <div
            class="transition-layer fixed inset-0 -z-[8] hidden bg-black/50 opacity-0"
        >
        </div>
        <main
            data-barba="container"
            data-barba-namespace={namespace}
            class="relative flex size-full flex-1 flex-col"
        >
            <slot />
        </main>
        <script src="../lib/barba.ts"></script>
    </body>
</html>
