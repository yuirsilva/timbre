{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "strictPropertyInitialization": false,
    "paths": {
      "@components/*": ["src/components/*"],
      "@/*": ["src/*"]
    },
    "types": ["vite-plugin-glsl/ext"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
